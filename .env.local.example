# =====================================
# KVK API
# =====================================
# Aanvragen op https://developers.kvk.nl
# Laat leeg of zet op "mock" voor de mock-modus (geen echte API call).
KVK_API_KEY=mock
KVK_API_BASE_URL=https://api.kvk.nl/api/v1

# Voor de TEST-omgeving (geen certificaat nodig, fake data — perfect om mee
# te starten). Dit is een PUBLIEKE test-key die KVK zelf in hun docs deelt:
# KVK_API_KEY=l7xx1f2691f2520d487b902f4e0b57a0b227
# KVK_API_BASE_URL=https://api.kvk.nl/test/api/v1

# Voor productie heb je een eigen API-key + PKIoverheid certificaat nodig.
# Zie README voor details.

# =====================================
# Paneel-authenticatie (Basic Auth)
# =====================================
# Beschermt het paneel tegen ongeautoriseerd gebruik van je KVK-quota.
# Beide leeg = open toegang (alleen handig voor lokaal ontwikkelen).
PANEL_USERNAME=
PANEL_PASSWORD=
